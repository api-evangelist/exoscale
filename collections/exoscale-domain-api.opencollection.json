              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve DNS domain details"
        },
        {
          "info": {
            "name": "Delete DNS Domain",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api-{zone}.exoscale.com/v2/dns-domain/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
