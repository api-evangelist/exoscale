            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create DNS domain"
        },
        {
          "info": {
            "name": "Retrieve DNS domain zone file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-{zone}.exoscale.com/v2/dns-domain/:id/zone",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve DNS domain zone file"
        },
        {
          "info": {
            "name": "Retrieve DNS domain details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-{zone}.exoscale.com/v2/dns-domain/:id",
